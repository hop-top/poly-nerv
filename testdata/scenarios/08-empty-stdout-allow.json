{
  "name": "empty-stdout-allow",
  "description": "Handler produces no output; treated as allow",
  "hooks": {
    "version": "1.0-draft",
    "hooks": [
      {
        "name": "empty-hook",
        "on": "PreToolUse",
        "match": "Bash",
        "run": "./testdata/handlers/empty-stdout.sh"
      }
    ]
  },
  "envelope": {
    "event": "PreToolUse",
    "cli": {"name": "claude", "version": "1.0.0"},
    "session": {"id": "test-empty"},
    "payload": {
      "tool_name": "Bash",
      "tool_input": {"command": "echo ok"}
    }
  },
  "expected": {
    "action": "allow"
  }
}
