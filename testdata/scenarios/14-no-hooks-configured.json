{
  "name": "no-hooks-configured",
  "description": "Empty hooks config yields allow for any event",
  "hooks": {
    "version": "1.0-draft",
    "hooks": []
  },
  "envelope": {
    "event": "PreToolUse",
    "cli": {"name": "claude", "version": "1.0.0"},
    "session": {"id": "test-no-hooks"},
    "payload": {
      "tool_name": "Bash",
      "tool_input": {"command": "rm -rf /"}
    }
  },
  "expected": {
    "action": "allow"
  }
}
