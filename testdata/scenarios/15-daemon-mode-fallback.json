{
  "name": "daemon-mode-fallback",
  "description": "Socket connection refused; falls back to stateless dispatch with allow",
  "hooks": {
    "version": "1.0-draft",
    "hooks": [
      {
        "name": "block-rm",
        "on": "PreToolUse",
        "match": "Bash",
        "run": "./testdata/handlers/block-rm-rf.sh"
      }
    ]
  },
  "envelope": {
    "event": "PreToolUse",
    "cli": {"name": "claude", "version": "1.0.0"},
    "session": {"id": "test-daemon-fallback"},
    "payload": {
      "tool_name": "Bash",
      "tool_input": {"command": "echo safe"}
    }
  },
  "daemon": {
    "socket": "/tmp/nerv-nonexistent.sock",
    "expect_fallback": true
  },
  "expected": {
    "action": "allow",
    "metadata_contains": {"fallback": "stateless"}
  }
}
