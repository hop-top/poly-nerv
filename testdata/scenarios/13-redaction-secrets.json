{
  "name": "redaction-secrets",
  "description": "Bearer token in payload is redacted before handler sees it",
  "hooks": {
    "version": "1.0-draft",
    "hooks": [
      {
        "name": "passthrough",
        "on": "PostToolUse",
        "run": "./testdata/handlers/allow-passthrough.sh"
      }
    ]
  },
  "envelope": {
    "event": "PostToolUse",
    "cli": {"name": "claude", "version": "1.0.0"},
    "session": {"id": "test-redact"},
    "payload": {
      "tool_name": "Bash",
      "tool_input": {"command": "curl -H 'Authorization: Bearer {{FAKE_STRIPE_KEY}}' https://api.example.com"}
    }
  },
  "expected": {
    "action": "allow",
    "redacted_fields": ["payload.tool_input.command"],
    "redaction_pattern": "Bearer ${REDACTED:token}"
  }
}
