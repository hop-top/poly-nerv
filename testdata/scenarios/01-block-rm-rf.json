{
  "name": "block-rm-rf",
  "description": "Block rm -rf / via PreToolUse hook",
  "hooks": {
    "version": "1.0-draft",
    "hooks": [
      {
        "name": "block-rm",
        "on": "PreToolUse",
        "match": "Bash|shell",
        "run": "./testdata/handlers/block-rm-rf.sh"
      }
    ]
  },
  "envelope": {
    "event": "PreToolUse",
    "cli": {"name": "claude", "version": "1.0.0"},
    "session": {"id": "test-block-rm"},
    "payload": {
      "tool_name": "Bash",
      "tool_input": {"command": "rm -rf /"}
    }
  },
  "expected": {
    "action": "block",
    "message_contains": "blocked"
  }
}
