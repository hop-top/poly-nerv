{
  "name": "claude-block-rm",
  "description": "Claude CLI: rm -rf blocked via PreToolUse",
  "cli": "claude",
  "native_event": "PreToolUse",
  "hooks": {
    "version": "1.0-draft",
    "hooks": [
      {
        "name": "block-rm",
        "on": "PreToolUse",
        "match": "Bash|shell",
        "run": "./testdata/handlers/block-rm-rf.sh"
      }
    ]
  },
  "envelope": {
    "event": "PreToolUse",
    "cli": {"name": "claude", "version": "1.0.0"},
    "session": {"id": "parity-claude"},
    "payload": {
      "tool_name": "Bash",
      "tool_input": {"command": "rm -rf /"}
    }
  },
  "expected": {
    "action": "block",
    "message_contains": "blocked"
  }
}
