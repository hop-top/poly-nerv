{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.hop.top/crtx/v0.1/events.schema.json",
  "title": "crtx Event Payloads v0.1",
  "description": "Canonical bus-event payload schemas for crtx v0.1. See events.md for the prose specification. Each $defs/<Topic>Payload entry validates the payload carried by the topic of the same name; callers reference them by topic. The schema has no top-level oneOf discriminator on topic because bus transports already provide the topic name out-of-band — wrapping payloads in a synthetic envelope here would force every producer to repeat what the transport already knows. To keep validation self-contained and avoid cross-file $ref resolver complexity, the ContentPart / Source / ToolCallPart / ToolResultPart / ThinkingPart / TextPart / ImagePart / ExtensionPart definitions are inlined from envelope.schema.json verbatim. They MUST stay in lockstep with the envelope schema; the envelope schema is the source of truth.",
  "type": "object",
  "$defs": {
    "UserReceivedPayload": {
      "type": "object",
      "required": ["envelope_id", "turn_id", "content"],
      "additionalProperties": false,
      "properties": {
        "envelope_id": { "type": "string", "minLength": 1 },
        "turn_id": { "type": "string", "minLength": 1 },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ContentPart" }
        },
        "in_reply_to_call_id": { "type": "string", "minLength": 1 }
      }
    },
    "AssistantEmittedPayload": {
      "type": "object",
      "required": ["envelope_id", "turn_id", "content"],
      "additionalProperties": false,
      "properties": {
        "envelope_id": { "type": "string", "minLength": 1 },
        "turn_id": { "type": "string", "minLength": 1 },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ContentPart" }
        },
        "agent_id": { "type": "string", "minLength": 1 },
        "in_reply_to_call_id": { "type": "string", "minLength": 1 }
      }
    },
    "ToolCalledPayload": {
      "type": "object",
      "required": ["envelope_id", "turn_id", "call_id", "name", "input"],
      "additionalProperties": false,
      "properties": {
        "envelope_id": { "type": "string", "minLength": 1 },
        "turn_id": { "type": "string", "minLength": 1 },
        "call_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "oneOf": [
            { "type": "object" },
            { "type": "string" }
          ]
        },
        "parent_call_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1 }
      }
    },
    "ToolCompletedPayload": {
      "type": "object",
      "required": ["envelope_id", "turn_id", "call_id", "output"],
      "additionalProperties": false,
      "properties": {
        "envelope_id": { "type": "string", "minLength": 1 },
        "turn_id": { "type": "string", "minLength": 1 },
        "call_id": { "type": "string", "minLength": 1 },
        "output": {},
        "is_error": { "type": "boolean", "default": false },
        "child_envelope_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1 }
      }
    },
    "ThinkingEmittedPayload": {
      "type": "object",
      "required": ["envelope_id", "turn_id", "text"],
      "additionalProperties": false,
      "properties": {
        "envelope_id": { "type": "string", "minLength": 1 },
        "turn_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "signature": { "type": "string" },
        "agent_id": { "type": "string", "minLength": 1 },
        "in_reply_to_call_id": { "type": "string", "minLength": 1 }
      }
    },
    "SystemInjectedPayload": {
      "type": "object",
      "required": ["envelope_id", "turn_id", "content"],
      "additionalProperties": false,
      "properties": {
        "envelope_id": { "type": "string", "minLength": 1 },
        "turn_id": { "type": "string", "minLength": 1 },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ContentPart" }
        },
        "in_reply_to_call_id": { "type": "string", "minLength": 1 }
      }
    },
    "SessionCreatedPayload": {
      "type": "object",
      "required": ["envelope_id", "created_at", "source"],
      "additionalProperties": false,
      "properties": {
        "envelope_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "source": { "$ref": "#/$defs/Source" },
        "injected_turns": {
          "type": "array",
          "items": { "$ref": "#/$defs/InjectedTurnRef" }
        }
      }
    },
    "SessionForkedPayload": {
      "type": "object",
      "required": ["parent_id", "child_id", "fork_point", "created_at"],
      "additionalProperties": false,
      "properties": {
        "parent_id": { "type": "string", "minLength": 1 },
        "child_id": { "type": "string", "minLength": 1 },
        "fork_point": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "SessionNestedPayload": {
      "type": "object",
      "required": ["parent_id", "child_id", "call_id", "created_at"],
      "additionalProperties": false,
      "properties": {
        "parent_id": { "type": "string", "minLength": 1 },
        "child_id": { "type": "string", "minLength": 1 },
        "call_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "SessionReturnedPayload": {
      "type": "object",
      "required": ["parent_id", "child_id", "call_id", "created_at"],
      "additionalProperties": false,
      "properties": {
        "parent_id": { "type": "string", "minLength": 1 },
        "child_id": { "type": "string", "minLength": 1 },
        "call_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "is_error": { "type": "boolean", "default": false }
      }
    },

    "Source": {
      "type": "object",
      "required": ["kind", "version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "instance": { "type": "string" }
      }
    },

    "ContentPart": {
      "oneOf": [
        { "$ref": "#/$defs/TextPart" },
        { "$ref": "#/$defs/ToolCallPart" },
        { "$ref": "#/$defs/ToolResultPart" },
        { "$ref": "#/$defs/ImagePart" },
        { "$ref": "#/$defs/ThinkingPart" },
        { "$ref": "#/$defs/ExtensionPart" }
      ]
    },

    "TextPart": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },

    "ToolCallPart": {
      "type": "object",
      "required": ["type", "call_id", "name", "input"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tool_call" },
        "call_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "oneOf": [
            { "type": "object" },
            { "type": "string" }
          ]
        },
        "parent_call_id": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },

    "ToolResultPart": {
      "type": "object",
      "required": ["type", "call_id", "output"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tool_result" },
        "call_id": { "type": "string", "minLength": 1 },
        "output": {},
        "is_error": { "type": "boolean", "default": false },
        "child_envelope_id": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },

    "InjectedTurnRef": {
      "type": "object",
      "required": ["envelope_id", "start_turn_id", "end_turn_id"],
      "additionalProperties": false,
      "properties": {
        "envelope_id": { "type": "string", "minLength": 1 },
        "start_turn_id": { "type": "string", "minLength": 1 },
        "end_turn_id": { "type": "string", "minLength": 1 },
        "injected_after_turn_id": { "type": "string", "minLength": 1 }
      }
    },

    "ImagePart": {
      "type": "object",
      "required": ["type", "mime"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "image" },
        "mime": { "type": "string", "pattern": "^[a-z]+/[a-zA-Z0-9.+-]+$" },
        "data": { "type": "string", "contentEncoding": "base64" },
        "url": { "type": "string", "format": "uri" },
        "alt": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "oneOf": [
        { "required": ["data"], "not": { "required": ["url"] } },
        { "required": ["url"], "not": { "required": ["data"] } }
      ]
    },

    "ThinkingPart": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "thinking" },
        "text": { "type": "string" },
        "signature": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },

    "ExtensionPart": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^x-[a-zA-Z0-9._-]+$"
        }
      }
    }
  }
}
