FROM node:24.22.1-slim AS base

# Go toolchain for opencode + nerv build
COPY --from=golang:1.27.3-bookworm /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    git jq curl ca-certificates python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

# CLI selection
ARG CLI_NAME
ARG CLI_VERSION
ARG CLI_PACKAGE
ARG CLI_INSTALL_METHOD=npm

# Install the specific CLI version
RUN if [ "$CLI_INSTALL_METHOD" = "npm" ]; then \
      npm i -g ${CLI_PACKAGE}@${CLI_VERSION}; \
    elif [ "$CLI_INSTALL_METHOD" = "go" ]; then \
      if [ "$CLI_VERSION" = "latest" ]; then \
        go install ${CLI_PACKAGE}@latest; \
      else \
        case "$CLI_VERSION" in v*) ;; *) CLI_VERSION="v${CLI_VERSION}" ;; esac && \
        go install ${CLI_PACKAGE}@${CLI_VERSION}; \
      fi; \
    elif [ "$CLI_INSTALL_METHOD" = "pip" ]; then \
      pip install --break-system-packages ${CLI_PACKAGE}==${CLI_VERSION} 2>/dev/null || \
      pip install --break-system-packages ${CLI_PACKAGE} || \
      { echo "ERROR: Failed to install pip package '${CLI_PACKAGE}'" >&2; exit 1; }; \
    fi

# Python for pip-installed CLIs
RUN if [ "$CLI_INSTALL_METHOD" = "pip" ]; then \
      apt-get update && apt-get install -y --no-install-recommends python3 python3-pip && \
      rm -rf /var/lib/apt/lists/* && \
      if [ "$CLI_VERSION" = "latest" ]; then \
        pip3 install --break-system-packages ${CLI_PACKAGE}; \
      else \
        pip3 install --break-system-packages ${CLI_PACKAGE}==${CLI_VERSION}; \
      fi; \
    fi

# GitHub release binary (goose, opencode 2.x). CLI_PACKAGE = owner/repo.
# Pinned version + per-arch sha256 (from the release asset digests); bump
# both together.
ARG GOOSE_SHA256_X86_64=fd3932908328fac850ca7ad2a8289c744e0c2ddaf4c5a2338709fb17a00b3a4c
ARG GOOSE_SHA256_AARCH64=ea83f59bb165a3d999dd00edf69a58028747f31e404b96f0153452c6b1651188
# opencode 2.2.5 (anomalyco/opencode SHA256SUMS)
ARG OPENCODE_SHA256_X86_64=09f44302c10fd036912f59c81fd1aef5df45dd06f649197f9dfc9bbe2a79614e
ARG OPENCODE_SHA256_AARCH64=5a528f42caf576c6cdece6a191eb273d3db54effa5518e0402684d8f8026aeb6
RUN if [ "$CLI_INSTALL_METHOD" = "github-release" ]; then \
      set -eu; \
      case "$CLI_NAME" in goose|opencode) ;; *) echo "ERROR: github-release supports goose and opencode only" >&2; exit 1 ;; esac; \
      case "$(uname -m)" in \
        x86_64)  arch=x86_64;  oc_arch=x64;   gsum="$GOOSE_SHA256_X86_64";  osum="$OPENCODE_SHA256_X86_64" ;; \
        aarch64) arch=aarch64; oc_arch=arm64; gsum="$GOOSE_SHA256_AARCH64"; osum="$OPENCODE_SHA256_AARCH64" ;; \
        *) echo "ERROR: unsupported arch $(uname -m)" >&2; exit 1 ;; \
      esac; \
      if [ "$CLI_NAME" = "goose" ]; then \
        url="https://github.com/${CLI_PACKAGE}/releases/download/v${CLI_VERSION}/goose-${arch}-unknown-linux-gnu.tar.gz"; sum="$gsum"; member=./goose; \
      else \
        url="https://github.com/${CLI_PACKAGE}/releases/download/v${CLI_VERSION}/opencode-linux-${oc_arch}.tar.gz"; sum="$osum"; member=opencode; \
      fi; \
      curl -fsSL --proto '=https' --tlsv1.2 -o /tmp/cli.tgz "$url"; \
      echo "${sum}  /tmp/cli.tgz" | sha256sum -c -; \
      tar -xzf /tmp/cli.tgz -C /usr/local/bin "$member"; \
      rm /tmp/cli.tgz; \
      "$CLI_NAME" --version; \
    fi

# Codex feature flag
RUN if [ "$CLI_NAME" = "codex" ]; then \
      mkdir -p ~/.codex && \
      echo 'codex_hooks = true' > ~/.codex/config.toml; \
    fi

# OpenHands config stub
RUN if [ "$CLI_NAME" = "openhands" ]; then \
      mkdir -p ~/.openhands && echo '{}' > ~/.openhands/hooks.json; \
    fi

# Copy nerv source
COPY . /nerv
WORKDIR /nerv

# Build nerv binaries
RUN CGO_ENABLED=0 go build -buildvcs=false -o /usr/local/bin/nerv ./cmd/nerv && \
    CGO_ENABLED=0 go build -buildvcs=false -o /usr/local/bin/nervd ./cmd/nervd

# Verify CLI is installed
RUN which ${CLI_NAME} || echo "CLI binary not in PATH (expected for some install methods)"

ENTRYPOINT ["go", "test", "-v", "-count=1", "-tags", "conformance"]
CMD ["-run", "TestConformance", "./adapters/..."]
