FROM node:24.22.1-slim AS base

# Go toolchain for opencode + nerv build
COPY --from=golang:1.27.3-bookworm /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"

# Python 3.12 for pip-installed CLIs (openhands requires ==3.12.*;
# bookworm ships 3.11). Copied from the official image on the same
# Debian release; prefix /usr/local matches, so no relocation.
COPY --from=python:3.12.16-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 \
     /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=python:3.12.16-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 \
     /usr/local/lib/libpython3.12.so.1.0 /usr/local/lib/
COPY --from=python:3.12.16-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 \
     /usr/local/bin/python3.12 /usr/local/bin/

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    git jq curl ca-certificates \
    libsqlite3-0 libreadline8 libncursesw6 && \
    rm -rf /var/lib/apt/lists/* && \
    ldconfig && \
    ln -s python3.12 /usr/local/bin/python3 && \
    python3 --version && python3 -m pip --version

# CLI selection. CLI_KEY is the versions.yaml matrix key (defaults to
# CLI_NAME; differs for opencode-v2). Package, install method and, for
# github-release, sha256 pins all come from versions.yaml.
ARG CLI_NAME
ARG CLI_KEY=${CLI_NAME}
ARG CLI_VERSION

COPY versions.yaml /nerv-install/versions.yaml
COPY scripts/install-cli.sh /nerv-install/scripts/install-cli.sh
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN /nerv-install/scripts/install-cli.sh "${CLI_KEY}" "${CLI_VERSION}"

# Codex feature flag
RUN if [ "$CLI_NAME" = "codex" ]; then \
      mkdir -p ~/.codex && \
      echo 'codex_hooks = true' > ~/.codex/config.toml; \
    fi

# OpenHands config stub
RUN if [ "$CLI_NAME" = "openhands" ]; then \
      mkdir -p ~/.openhands && echo '{}' > ~/.openhands/hooks.json; \
    fi

# Copy nerv source
COPY . /nerv
WORKDIR /nerv

# Build nerv binaries
RUN CGO_ENABLED=0 go build -buildvcs=false -o /usr/local/bin/nerv ./cmd/nerv && \
    CGO_ENABLED=0 go build -buildvcs=false -o /usr/local/bin/nervd ./cmd/nervd

# Verify CLI is installed
RUN which ${CLI_NAME} || echo "CLI binary not in PATH (expected for some install methods)"

ENTRYPOINT ["go", "test", "-v", "-count=1", "-tags", "conformance"]
CMD ["-run", "TestConformance", "./adapters/..."]
